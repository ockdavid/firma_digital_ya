# URL publica desde la que los firmantes abren su enlace.
APP_URL=http://localhost:3000

# Clave maestra: firma las cookies y deriva el HMAC de los tokens.
# Generala con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Si la cambias, todos los enlaces enviados dejan de funcionar.
APP_SECRET=

# Contrasena del panel. Solo la usas tu.
ADMIN_PASSWORD=

# console = no envia nada, guarda los correos en storage/outbox y muestra el enlace en la terminal.
# resend  = envio real (necesita RESEND_API_KEY y un dominio verificado en resend.com).
EMAIL_DRIVER=console
RESEND_API_KEY=
MAIL_FROM=Firmaya <contratos@tudominio.com>

# Limites
TOKEN_TTL_DAYS=30
MAX_AUTH_ATTEMPTS=5
LOCK_MINUTES=15
MAX_PDF_MB=25
