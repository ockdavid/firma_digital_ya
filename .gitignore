# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# firmaya: contratos y base de datos, nunca al repositorio
/data
/storage
!.env.example

# worker de pdf.js: se regenera con npm install
/public/pdf.worker.min.mjs

# Contratos sueltos en la raiz: nunca al repositorio
/*.pdf

# Nada de credenciales en el repositorio (este repo es publico)
/credenciales
